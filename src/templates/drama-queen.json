      "canonicalizer": "drama-queen",
      "schemaVersion": 1,
      "invariants": [],
      "schema": {
        "type": "object",
        "required": ["version", "sceneRead", "proposals", "active"],
        "properties": {
          "version": { "type": "number", "const": 1 },
          "sceneRead": { "type": "string", "maxLength": 1000 },
          "proposals": {
            "type": "array", "minItems": 1, "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["id", "title", "cast", "intent", "faultLine", "incompatibleAgendas", "refusal", "leverage", "stakes", "catalyst", "easyExit", "consequences", "stages", "guardrails"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 60 },
                "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                "cast": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
                "intent": { "type": "string", "enum": ["find-fault-lines", "stir-the-pot", "make-it-worse", "let-it-haunt-them"] },
                "faultLine": { "type": "string", "minLength": 1, "maxLength": 800 },
                "incompatibleAgendas": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
                "refusal": { "type": "string", "maxLength": 600 },
                "leverage": { "type": "string", "maxLength": 600 },
                "stakes": { "type": "string", "maxLength": 700 },
                "catalyst": {
                  "type": "object", "required": ["event", "provenance", "basis"],
                  "properties": {
                    "event": { "type": "string", "maxLength": 700 },
                    "provenance": { "type": "string", "enum": ["established", "inferred", "new-catalyst", "user-note"] },
                    "basis": { "type": "string", "maxLength": 500 }
                  },
                  "additionalProperties": false
                },
                "easyExit": { "type": "string", "maxLength": 600 },
                "consequences": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 500 } },
                "stages": {
                  "type": "array", "minItems": 6, "maxItems": 6,
                  "items": {
                    "type": "object", "required": ["label", "direction"],
                    "properties": {
                      "label": { "type": "string", "enum": ["Expose the Fault Line", "Test the Boundary", "Remove the Easy Exit", "Force a Choice", "Make It Cost Something", "Live With the Change"] },
                      "direction": { "type": "string", "minLength": 1, "maxLength": 900 }
                    },
                    "additionalProperties": false
                  }
                },
                "guardrails": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 300 } }
              },
              "additionalProperties": false
            }
          },
          "active": {
            "type": ["object", "null"],
            "required": ["proposalIndex", "beatIndex", "pressure", "damageCeiling", "activatedAtMessage"],
            "properties": {
              "proposalIndex": { "type": "number", "minimum": 0, "maximum": 5 },
              "beatIndex": { "type": "number", "minimum": 0, "maximum": 5 },
              "pressure": { "type": "string", "enum": ["simmer", "press", "corner", "break"] },
              "damageCeiling": { "type": "string", "enum": ["sting", "strain", "rupture", "catastrophe"] },
              "activatedAtMessage": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "enabled": true,
