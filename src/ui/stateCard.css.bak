/* ============================================================================
   SuperAgents — State Card floating panel
   ----------------------------------------------------------------------------
   A free-floating, draggable glass HUD for schema-driven state tracking.
   Loaded at runtime by src/ui/stateCard.js (injected <link>), not via the
   manifest, so the panel's styles travel with its module.

   Ported from VerseManager's stateCard.css. The docked-sidebar shell and
   edge toggle-tab are gone — positioning is owned by ui/draggablePanel.js
   (inline left/top). What remains is the panel chrome + the glass cards,
   renamed vm-sc- → sa-sc-. Panel shell uses the shared --sa-* tokens so it
   matches the modal; inner cards keep their tuned glass palette.
   ============================================================================ */

/* ── Panel shell (positioned by draggablePanel; fixed left/top inline) ── */
.sa-sc-panel {
    position: fixed;
    width: min(290px, 92vw);
    max-height: min(70vh, 720px);
    display: none;                 /* shown via the Settings toggle / controller */
    flex-direction: column;
    background: var(--sa-surface-main);
    border: 1px solid var(--sa-border-soft);
    border-radius: var(--sa-radius);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.45);
    z-index: var(--sa-z-panel);
    overflow: hidden;
}
.sa-sc-panel.sa-panel-open { display: flex; }

/* ── Header = drag handle (title + close) ── */
.sa-sc-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    cursor: grab;
    background: var(--sa-surface-rail);
    border-bottom: 1px solid var(--sa-border-faint);
    flex-shrink: 0;
}
.sa-panel--dragging .sa-sc-header { cursor: grabbing; }

.sa-sc-grip {
    font-size: 10px;
    color: var(--sa-text-ghost);
    flex-shrink: 0;
}
.sa-sc-title {
    font-size: var(--sa-font-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sa-text-faint);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.sa-sc-close {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--sa-radius);
    color: var(--sa-text-muted);
    cursor: pointer;
    font-size: 12px;
    transition: background 0.12s, color 0.12s;
    flex-shrink: 0;
}
.sa-sc-close:hover { background: var(--sa-surface-rail-hot); color: var(--sa-text-secondary); }

/* ── Collapse button (mirrors close; folds the body away in place) ── */
.sa-sc-collapse {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--sa-radius);
    color: var(--sa-text-muted);
    cursor: pointer;
    font-size: 12px;
    transition: background 0.12s, color 0.12s;
    flex-shrink: 0;
}
.sa-sc-collapse:hover { background: var(--sa-surface-rail-hot); color: var(--sa-text-secondary); }

/* ── Collapsed state: hide body + drop the header's bottom border so the
      panel shrinks to a slim draggable bar. ── */
.sa-sc-collapsed-panel { max-height: none; }
.sa-sc-collapsed-panel .sa-sc-body { display: none; }
.sa-sc-collapsed-panel .sa-sc-header { border-bottom: none; }

/* ── Scrollable body ── */
.sa-sc-body {
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    /* flex:1 + min-height:0 lets the body absorb the panel's remaining height
       and scroll internally when content overflows (many character cards) —
       without min-height:0 a flex child refuses to shrink below content size
       and the scrollbar never appears. */
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.08) transparent;
}
.sa-sc-body::-webkit-scrollbar { width: 4px; }
.sa-sc-body::-webkit-scrollbar-track { background: transparent; }
.sa-sc-body::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.08); border-radius: 2px; }

/* ── Cards (glass) ── */
.sa-sc-card {
    background: rgba(25, 20, 25, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    overflow: hidden;
    /* Don't let the flex body squeeze a card's content — cards keep their
       natural height and the body scrolls instead. Critical for the pinned
       "You" / World Events cards so the user stats always have room. */
    flex-shrink: 0;
    transition: border-color 0.15s;
}
.sa-sc-card:hover { border-color: rgba(255, 255, 255, 0.09); }

.sa-sc-card-header {
    display: flex;
    align-items: center;
    padding: 8px 10px;
    gap: 8px;
    cursor: pointer;
    transition: background 0.1s;
}
.sa-sc-pinned .sa-sc-card-header { cursor: default; }
.sa-sc-card-header:hover { background: rgba(255, 255, 255, 0.02); }
.sa-sc-pinned .sa-sc-card-header:hover { background: transparent; }

.sa-sc-card-icon {
    font-size: 11px;
    color: rgba(200, 210, 225, 0.3);
    width: 16px;
    text-align: center;
    flex-shrink: 0;
}
.sa-sc-card-label {
    font-size: 11px;
    font-weight: 500;
    color: rgba(230, 235, 245, 0.85);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.sa-sc-collapse-icon {
    font-size: 9px;
    color: rgba(200, 210, 225, 0.2);
    transition: transform 0.2s;
    flex-shrink: 0;
}
.sa-sc-collapsed .sa-sc-collapse-icon { transform: rotate(-90deg); }

.sa-sc-card-body {
    padding: 0 10px 10px;
    transition: max-height 0.2s ease, opacity 0.15s ease, padding 0.2s ease;
    max-height: 600px;
    opacity: 1;
    overflow: hidden;
}
.sa-sc-collapsed .sa-sc-card-body {
    max-height: 0;
    opacity: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* ── Compact meter strip (visible when collapsed) ── */
.sa-sc-compact { display: none; padding: 0 10px 8px; gap: 4px; }
.sa-sc-collapsed .sa-sc-compact { display: flex; }
.sa-sc-compact-meter { flex: 1; min-width: 0; }
.sa-sc-compact-track {
    height: 3px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 2px;
    overflow: hidden;
}
.sa-sc-compact-fill { height: 100%; border-radius: 2px; opacity: 0.6; transition: width 0.4s ease; }

/* ── Avatar ── */
.sa-sc-avatar {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 600;
    flex-shrink: 0;
}

/* ── Fields ── */
.sa-sc-field {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 3px 0;
    gap: 8px;
}
.sa-sc-field-label { font-size: 10.5px; color: rgba(200, 210, 225, 0.6); flex-shrink: 0; white-space: nowrap; }
.sa-sc-field-value {
    font-size: 10.5px;
    color: rgba(220, 225, 235, 0.65);
    font-weight: 500;
    text-align: right;
    max-width: 60%;
    line-height: 1.4;
}

/* ── Badge ── */
.sa-sc-badge { display: inline-block; font-size: 9.5px; padding: 1px 8px; border-radius: 10px; font-weight: 500; }

/* ── Tags ── */
.sa-sc-tags { display: flex; flex-wrap: wrap; gap: 4px; padding: 2px 0 4px; }
.sa-sc-tag {
    font-size: 9px;
    padding: 1px 7px;
    border-radius: 8px;
    background: rgba(133, 183, 235, 0.1);
    color: rgba(133, 183, 235, 0.7);
    font-weight: 500;
}

/* ── Separator ── */
.sa-sc-sep { height: 1px; background: rgba(255, 255, 255, 0.04); margin: 4px 0; }

/* ── Meters ── */
.sa-sc-meter, .sa-sc-meter-col { padding: 3px 0; }
.sa-sc-meters-dual { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.sa-sc-meter-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px; }
.sa-sc-meter-label {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.35);
    display: flex;
    align-items: center;
    gap: 4px;
}
.sa-sc-meter-dot { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; opacity: 0.7; }
.sa-sc-meter-num { font-size: 9px; color: rgba(200, 210, 225, 0.3); font-weight: 500; }
.sa-sc-meter-track { height: 3px; background: rgba(255, 255, 255, 0.04); border-radius: 2px; overflow: hidden; }
.sa-sc-meter-fill { height: 100%; border-radius: 2px; opacity: 0.55; transition: width 0.4s ease; }

/* ── World Events ── */
.sa-sc-world-events .sa-sc-card-body { padding-top: 2px; }
.sa-sc-event {
    position: relative;
    padding: 3px 0 3px 14px;
    font-size: 10.5px;
    color: rgba(220, 225, 235, 0.6);
    line-height: 1.45;
}
.sa-sc-event::before {
    content: '•';
    position: absolute;
    left: 2px;
    top: 3px;
    color: rgba(175, 169, 236, 0.45);
    font-size: 10px;
}
.sa-sc-event + .sa-sc-event { border-top: 1px solid rgba(255, 255, 255, 0.03); }

/* ── User Stats card accent ── */
.sa-sc-card[data-type="user"] .sa-sc-card-icon { color: rgba(93, 202, 123, 0.5); }

/* ── Empty state ── */
.sa-sc-empty {
    padding: 24px 12px;
    text-align: center;
    font-size: 11px;
    color: rgba(200, 210, 225, 0.25);
    line-height: 1.6;
}
.sa-sc-empty-hint {
    display: block;
    font-size: 10px;
    color: rgba(200, 210, 225, 0.15);
    margin-top: 4px;
}


/* ── Resize handles (injected by draggablePanel when resizable:true) ──
   Thin invisible slivers along each edge + slightly larger corner squares.
   The panel keeps overflow:hidden so handles sit flush inside the rounded
   border; they're transparent and only express themselves via the cursor. ── */
.sa-panel-rh { position: absolute; z-index: 10; }
.sa-panel-rh-n  { top: 0; left: 8px; right: 8px; height: 5px; cursor: n-resize; }
.sa-panel-rh-s  { bottom: 0; left: 8px; right: 8px; height: 5px; cursor: s-resize; }
.sa-panel-rh-e  { right: 0; top: 8px; bottom: 8px; width: 5px; cursor: e-resize; }
.sa-panel-rh-w  { left: 0; top: 8px; bottom: 8px; width: 5px; cursor: w-resize; }
.sa-panel-rh-ne { top: 0; right: 0; width: 12px; height: 12px; cursor: ne-resize; }
.sa-panel-rh-se { bottom: 0; right: 0; width: 12px; height: 12px; cursor: se-resize; }
.sa-panel-rh-sw { bottom: 0; left: 0; width: 12px; height: 12px; cursor: sw-resize; }
.sa-panel-rh-nw { top: 0; left: 0; width: 12px; height: 12px; cursor: nw-resize; }

/* Faint grip dots on the SE corner so the resize affordance is discoverable. */
.sa-panel-rh-se::after {
    content: '';
    position: absolute;
    right: 2px;
    bottom: 2px;
    width: 6px;
    height: 6px;
    border-right: 2px solid rgba(255, 255, 255, 0.18);
    border-bottom: 2px solid rgba(255, 255, 255, 0.18);
    border-bottom-right-radius: 3px;
}

/* While resizing: kill transitions + text selection, freeze inner pointer
   events so a fast drag doesn't get swallowed by a child element. */
.sa-panel--resizing { transition: none !important; user-select: none; }
.sa-panel--resizing * { pointer-events: none; }

/* A resizable panel manages its own height inline; don't let the CSS cap fight
   the dragged height. (applySize also sets max-height:none inline once a size
   is stored, but this keeps a freshly-shown unsized panel from clipping.) */
.sa-sc-panel.sa-panel-resizable { max-height: min(80vh, 860px); }

/* Collapsed + resizable: the slim bar wins over any stored height so the
   folded panel doesn't keep a tall transparent body region. */
.sa-sc-collapsed-panel.sa-panel-resizable { height: auto !important; }
